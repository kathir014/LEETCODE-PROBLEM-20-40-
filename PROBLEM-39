import java.util.*;

class Main {
    public static void main(String[] args) {

        int[] candidates = {2, 3, 6, 7};
        int target = 7;

        Solution s = new Solution();

        List<List<Integer>> result = s.combinationSum(candidates, target);

        System.out.println(result);
    }
}

class Solution {
    public List<List<Integer>> combinationSum(int[] candidates, int target) {

        List<List<Integer>> result = new ArrayList<>();
        find(candidates, target, 0, new ArrayList<>(), result);

        return result;
    }

    public void find(int[] arr, int target, int index,
                     List<Integer> current, List<List<Integer>> result) {

        if (target == 0) {
            result.add(new ArrayList<>(current));
            return;
        }

        if (target < 0 || index == arr.length) {
            return;
        }

        current.add(arr[index]);
        find(arr, target - arr[index], index, current, result);

        current.remove(current.size() - 1);
        find(arr, target, index + 1, current, result);
    }
}
