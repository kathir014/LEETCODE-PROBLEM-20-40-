class Solution {
    public int divide(int dividend, int divisor) {

        // Special case
        if (dividend == Integer.MIN_VALUE && divisor == -1) {
            return Integer.MAX_VALUE;
        }

        long div = Math.abs((long) dividend);
        long die = Math.abs((long) divisor);

        int count = 0;

        while (div >= die) {
            long temp = die;
            int multiple = 1;

            while (div >= (temp << 1)) {
                temp = temp << 1;
                multiple = multiple << 1;
            }

            div = div - temp;
            count = count + multiple;
        }

        // Check whether answer should be negative
        if ((dividend < 0) != (divisor < 0)) {
            count = -count;
        }

        return count;
    }
}
